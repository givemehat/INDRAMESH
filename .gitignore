# ---- Python build / cache artefacts (were previously committed) ----
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.ruff_cache/
.mypy_cache/

# ---- Ephemeral test / scratch directories ----
# Python's tempfile and pytest's basetemp have both been pointed at the repository root at
# various points; the result was thousands of empty `tmp*/` and `pytest-of-*/` directories in
# the working tree. Empty directories are invisible to git and very visible to a human (or a
# judge) who opens the tree, so they are ignored outright and safe to delete on sight.
tmp*/
pytest-of-*/
pytest-cache-files-*/
.hypothesis/
.sbx_tmp/
/out/

# ---- Virtual environments ----
.venv/
venv/
env/

# ---- Local scan artefacts ----
indramesh_report.json
indramesh_recommendations.json
*.log
# pytest/pytest-run stderr captures (`run.err`, `baseline.err`, ...). Only the `_`-prefixed
# scratch ones were ignored before, so a run captured outside the scratch convention showed
# up as untracked noise after every test run.
*.err

# ---- Scratch ----
_e2e/
_v/
_check_*.py
_raw.py
_patch_*.py

# Measurement scratch. An ad-hoc audit script and its captured output were committed once,
# which put throwaway files in the history and makes a reviewer read noise instead of code.
# One-off probes belong in the commit message or in a real test, never in the tree.
_*.py
_*.txt
_*.err
!.gitignore

# ---- pyvis writes its CDN assets into ./lib when a graph is rendered ----
lib/

# ---- Large cloned corpora (fetched by validate_real_world.py) ----
data/tink-java/

# ---- Third-party benchmark corpora (re-fetched at a pinned SHA by benchmark/run_benchmark.py) ----
benchmark/corpora/

# Scratch commit-message files
.gitmsg.txt

# ---- Published PDFs fetched to VERIFY research notes ----
# NIST publications are not ours to redistribute. research/sources/ cites the canonical URL for
# each document, and the verification step (download, extract, diff against our figures)
# is re-runnable by anyone from those URLs.
*.pdf

# Benchmark / mutation scratch output (regenerated by run_benchmark.py and mutation_test.py)
/tmp_out/
*.tmpout
# mutation_test.py / run_benchmark.py scratch output (buffered, written at exit)
m*.txt

# Third-party corpora cloned by the benchmark harness (pinned, not committed)
benchmark/corpora/

# Reference attachment from the SIH deck comparison; unreadable (truncated archive), kept local only
_ref/

# ---- SIH pitch kit: private working notes ----
# Contains the problem-statement ID, our measured weak spots, and judge-question strategy.
# Strategy material must never reach the public repo or the judging panel.
SIH_PITCH_private.md
*_PITCH_private.md

# Reference repos
reference_repos/
research/

# Opt-in durable scan history (INDRAMESH_HISTORY_DB); never commit a local db
*.db
*.sqlite3
*.out
*.err
half1.txt
